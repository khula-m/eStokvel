generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  phoneNumber          String         @unique
  email                String?        @unique
  fullName             String
  idNumber             String?
  passwordHash         String
  language             String         @default("en")
  role                 UserRole       @default(MEMBER)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastLogin            DateTime?
  members              Member[]
  createdGroups        StokvelGroup[]
  recordedTransactions Transaction[]  @relation("TransactionRecordedBy")

  @@map("users")
}

model StokvelGroup {
  id                    String        @id @default(cuid())
  name                  String
  code                  String        @unique
  description           String?
  contributionAmount    Float         @default(0)
  contributionFrequency String        @default("MONTHLY")
  payoutDate            DateTime?
  currency              String        @default("ZAR")
  meetingSchedule       String?
  isActive              Boolean       @default(true)
  createdById           String
  createdAt             DateTime      @default(now())
  members               Member[]
  createdBy             User          @relation(fields: [createdById], references: [id])
  transactions          Transaction[]

  @@map("stokvel_groups")
}

model Member {
  id             String        @id @default(cuid())
  userId         String
  stokvelGroupId String
  role           MemberRole    @default(MEMBER)
  joinedAt       DateTime      @default(now())
  group          StokvelGroup  @relation(fields: [stokvelGroupId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  transactions   Transaction[]

  @@unique([userId, stokvelGroupId])
  @@map("members")
}

model Transaction {
  id              String            @id @default(cuid())
  stokvelGroupId  String
  memberId        String
  transactionType TransactionType
  amount          Float
  currency        String            @default("ZAR")
  referenceNumber String?           @unique
  paymentMethod   PaymentMethod
  transactionDate DateTime
  recordDate      DateTime          @default(now())
  recordedById    String
  status          TransactionStatus @default(PENDING)
  notes           String?
  metadata        Json?
  receiptUrl      String?
  member          Member            @relation(fields: [memberId], references: [id])
  recordedBy      User              @relation("TransactionRecordedBy", fields: [recordedById], references: [id])
  group           StokvelGroup      @relation(fields: [stokvelGroupId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  CONTRIBUTION
  PAYOUT
  FINE_PAYMENT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  INTEREST
  EXPENSE
  ADJUSTMENT
}

enum MemberRole {
  TREASURER
  SECRETARY
  CHAIRPERSON
  MEMBER
}

enum UserRole {
  MEMBER
  TREASURER
  SECRETARY
  CHAIRPERSON
  ADMIN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  VOUCHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}
