# API Configuration for eStokvel Mobile
# 
# OPTION 1: LAN Mode (same WiFi network)
# Run: ipconfig (Windows) or ifconfig (Mac/Linux) to get your IP
# EXPO_PUBLIC_API_URL=http://YOUR_IP:5000/api
#
# OPTION 2: Tunnel Mode (any network, uses ngrok)
# 1. Run your backend: cd backend && npm run dev
# 2. Run ngrok: ngrok http 5000
# 3. Copy the https URL from ngrok
# EXPO_PUBLIC_API_URL=https://YOUR_NGROK_URL.ngrok-free.app/api

EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
