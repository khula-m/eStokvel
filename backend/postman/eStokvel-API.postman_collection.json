{
  "info": {
    "name": "eStokvel API",
    "description": "Complete API collection for eStokvel digital stokvel management platform.\n\nRole Hierarchy: SUPERADMIN > ADMIN > MEMBER\n\nAuth Methods:\n- SUPERADMIN: email + password (2h JWT)\n- ADMIN/MEMBER: phone + 5-digit PIN (7d JWT)\n\nSeed Credentials:\n- SUPERADMIN: admin@estokvel.co.za / Admin@2026!\n- ADMIN: 0831234567 / PIN: 56789 (must change)\n- MEMBER: 0831234568 / PIN: 94716 (must change)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Current active JWT token (set by login requests)"
    },
    {
      "key": "superadminToken",
      "value": "",
      "type": "string",
      "description": "SUPERADMIN JWT token"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "ADMIN JWT token"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string",
      "description": "MEMBER JWT token"
    },
    {
      "key": "groupId",
      "value": "your-group-id-here",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "your-transaction-id-here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "Auth - Public",
      "description": "Public authentication endpoints (no token required)",
      "item": [
        {
          "name": "PIN Login (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('token', jsonData.data.token);",
                  "        pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "        console.log('ADMIN token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phoneNumber\": \"0831234567\",\n    \"pin\": \"56789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as ADMIN using phone number + 5-digit PIN.\nSeed ADMIN: 0831234567 / PIN: 56789 (must change on first login)"
          }
        },
        {
          "name": "PIN Login (MEMBER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('token', jsonData.data.token);",
                  "        pm.collectionVariables.set('memberToken', jsonData.data.token);",
                  "        console.log('MEMBER token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phoneNumber\": \"0831234568\",\n    \"pin\": \"94716\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as MEMBER using phone number + 5-digit PIN.\nSeed MEMBERS: 0831234568-72 / PIN: 94716 (must change on first login)"
          }
        },
        {
          "name": "SUPERADMIN Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('token', jsonData.data.token);",
                  "        pm.collectionVariables.set('superadminToken', jsonData.data.token);",
                  "        console.log('SUPERADMIN token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@estokvel.co.za\",\n    \"password\": \"Admin@2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/superadmin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "superadmin", "login"]
            },
            "description": "Login as SUPERADMIN using email + complex password.\nSeed: admin@estokvel.co.za / Admin@2026!\nReturns 2-hour JWT token."
          }
        }
      ]
    },
    {
      "name": "Auth - Protected",
      "description": "Authenticated endpoints (requires valid JWT token)",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Get the currently authenticated user's profile information."
          }
        },
        {
          "name": "Change PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentPin\": \"56789\",\n    \"newPin\": \"12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-pin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-pin"]
            },
            "description": "Change the current user's PIN. Required on first login (mustChangePin flag).\nPIN must be exactly 5 digits."
          }
        }
      ]
    },
    {
      "name": "Auth - SUPERADMIN Only",
      "description": "Routes restricted to SUPERADMIN role only",
      "item": [
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phoneNumber\": \"0841112222\",\n    \"fullName\": \"New Admin User\",\n    \"pin\": \"11111\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "create"]
            },
            "description": "Create a new ADMIN user. SUPERADMIN only.\nAssigns UserRole.ADMIN. PIN must be 5 digits."
          }
        },
        {
          "name": "List All Admins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "list"]
            },
            "description": "List all users with ADMIN role. SUPERADMIN only."
          }
        },
        {
          "name": "Delete Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/:adminId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", ":adminId"],
              "variable": [
                {
                  "key": "adminId",
                  "value": "admin-user-id-here"
                }
              ]
            },
            "description": "Delete an ADMIN user. SUPERADMIN only."
          }
        },
        {
          "name": "System Overview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/system/overview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "system", "overview"]
            },
            "description": "Get system-wide statistics (total users, groups, transactions). SUPERADMIN only."
          }
        }
      ]
    },
