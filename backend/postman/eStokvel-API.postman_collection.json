    {
      "name": "Payments",
      "description": "Payment proof and verification (all routes require authentication)",
      "item": [
        {
          "name": "Update Bank Details (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"bankName\": \"FNB\",\n    \"accountNumber\": \"62012345678\",\n    \"accountType\": \"SAVINGS\",\n    \"branchCode\": \"250655\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/groups/{{groupId}}/bank-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "groups", "{{groupId}}", "bank-details"]
            },
            "description": "Update bank details for a group. ADMIN only."
          }
        },
        {
          "name": "Get Bank Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/groups/{{groupId}}/bank-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "groups", "{{groupId}}", "bank-details"]
            },
            "description": "Get bank details for a group. Any group member can view."
          }
        },
        {
          "name": "Upload Payment Proof",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
