    {
      "name": "Transactions",
      "description": "Transaction management (all routes require authentication)",
      "item": [
        {
          "name": "Create Transaction (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"groupId\": \"{{groupId}}\",\n    \"amount\": 500,\n    \"type\": \"CONTRIBUTION\",\n    \"description\": \"Monthly contribution\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Create a transaction record. Requires group ADMIN role (requireAdminRole middleware)."
          }
        },
        {
          "name": "Make Contribution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"groupId\": \"{{groupId}}\",\n    \"amount\": 500,\n    \"paymentMethod\": \"BANK_TRANSFER\",\n    \"description\": \"My monthly contribution\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/contribute",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "contribute"]
            },
            "description": "Make a contribution payment to a group. Any authenticated member can contribute."
          }
        },
        {
          "name": "Get Group Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?groupId={{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "Get transactions for a group. Requires group membership (requireGroupMembership middleware)."
          }
        },
        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "my"]
            },
            "description": "Get the current user's own transactions across all groups."
          }
        },
        {
          "name": "Get Dashboard Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/dashboard/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "dashboard", "{{groupId}}"]
            },
            "description": "Get dashboard summary data for a group (charts, totals). Requires group membership."
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            },
            "description": "Get a specific transaction by ID. Requires group membership."
          }
        }
