            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/transactions/{{transactionId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "transactions", "{{transactionId}}", "verify"]
            },
            "description": "Verify a payment. ADMIN only."
          }
        },
        {
          "name": "Get Pending Payments (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/groups/{{groupId}}/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "groups", "{{groupId}}", "pending"]
            },
            "description": "Get pending payments awaiting verification. ADMIN only."
          }
        }
      ]
    },
