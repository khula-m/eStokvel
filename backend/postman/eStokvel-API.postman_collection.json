            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "proof",
                  "type": "file",
                  "src": "",
                  "description": "Payment proof image (JPG, PNG, PDF)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/transactions/{{transactionId}}/proof",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "transactions", "{{transactionId}}", "proof"]
            },
            "description": "Upload payment proof for a transaction. Any member who made the payment."
          }
        },
