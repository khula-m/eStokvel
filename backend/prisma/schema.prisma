generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  phoneNumber          String         @unique
  fullName             String
  pin                  String?        // 5-digit PIN (hashed) - for ADMIN/MEMBER
  password             String?        // Complex password (hashed) - for SUPERADMIN
  role                 UserRole       @default(MEMBER)
  mustChangePin        Boolean        @default(true)
  isVerified           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  email                String?        @unique
  idNumber             String?
  language             String         @default("en")
  lastLogin            DateTime?
  lastLoginIp          String?        // Track login IP for audit
  failedAttempts       Int            @default(0)    // Failed login counter
  lockedUntil          DateTime?      // Account lockout timestamp
  expoPushToken        String?        // Expo push notification token
  createdById          String?        // Who created this account (SUPERADMIN/ADMIN)
  createdByUser        User?          @relation("CreatedByUser", fields: [createdById], references: [id])
  createdUsers         User[]         @relation("CreatedByUser")
  members              Member[]
  createdGroups        StokvelGroup[] @relation("GroupCreator")
  recordedTransactions Transaction[]  @relation("TransactionRecordedBy")
  chatMessages         ChatMessage[]
  chatReplies          ChatReply[]
  announcements        Announcement[]  @relation("AnnouncementAuthor")
  announcementReads    AnnouncementRead[]
  meetings             Meeting[]       @relation("MeetingAuthor")
  meetingAttendance    MeetingAttendance[]

  @@index([role])         // fast SUPERADMIN/MEMBER filtering at scale
  @@index([createdAt])    // user listing sorted by signup date
}

model StokvelGroup {
  id                    String        @id @default(cuid())
  name                  String
  code                  String        @unique
  description           String?
  contributionAmount    Decimal       @default(0) @db.Decimal(12, 2)
  contributionFrequency String        @default("MONTHLY")
  payoutModel           PayoutModel   @default(ROTATING)
  durationMonths        Int           @default(12)  // 6, 12, 24, 36
  startDate             DateTime      @default(now())
  endDate               DateTime?     // Calculated: startDate + durationMonths
  payoutDate            DateTime?
  termPayoutProcessed   Boolean       @default(false) // For END_OF_TERM: true once final payout done
  currency              String        @default("ZAR")
  meetingSchedule       String?
  isActive              Boolean       @default(true)
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  // Bank details for the group
  bankName              String?
  accountNumber         String?
  accountHolder         String?
  branchCode            String?
  members               Member[]
  createdBy             User          @relation("GroupCreator", fields: [createdById], references: [id])
  transactions          Transaction[]
  chatMessages          ChatMessage[]
  announcements         Announcement[]
  meetings              Meeting[]

  @@index([isActive])     // filter active/inactive groups
  @@index([createdById])  // groups by creator for admin views
  @@map("stokvel_groups")
}

model Member {
  id             String        @id @default(cuid())
  userId         String
  stokvelGroupId String
  role           MemberRole    @default(MEMBER)
  joinedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // Member's bank details for receiving payouts
  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountHolder String?
  payoutBranchCode    String?
  nextPayoutOrder     Int?        // Round-robin payout order (1, 2, 3...)
  group          StokvelGroup  @relation(fields: [stokvelGroupId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([userId, stokvelGroupId])
  @@index([stokvelGroupId])
  @@index([userId])
  @@index([stokvelGroupId, role])      // filter admins/members per group
  @@index([userId, stokvelGroupId])    // fast membership lookups
  @@map("members")
}

model Transaction {
  id              String            @id @default(cuid())
  stokvelGroupId  String
  memberId        String
  transactionType TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("ZAR")
  referenceNumber String?           @unique
  paymentMethod   PaymentMethod
  transactionDate DateTime
  recordDate      DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recordedById    String
  status          TransactionStatus @default(PENDING)
  notes           String?
  metadata        Json?
  receiptUrl      String?
  // Ozow payment gateway fields
  ozowTransactionId  String?        // Ozow's transaction reference
  ozowPaymentStatus  String?        // Raw Ozow status string
  paidAt             DateTime?      // When payment was confirmed by gateway
  member          Member            @relation(fields: [memberId], references: [id])
  recordedBy      User              @relation("TransactionRecordedBy", fields: [recordedById], references: [id])
  group           StokvelGroup      @relation(fields: [stokvelGroupId], references: [id])

  @@map("transactions")
  @@index([stokvelGroupId])
  @@index([memberId])
  @@index([transactionDate])
  @@index([stokvelGroupId, transactionDate])
  @@index([status])
  @@index([stokvelGroupId, status])                  // group financial summaries
  @@index([memberId, status])                        // member balance queries
  @@index([memberId, transactionDate])               // member transaction history
  @@index([ozowTransactionId])                       // payment gateway lookups
  @@index([memberId, stokvelGroupId, status])         // double-click prevention
  @@index([stokvelGroupId, transactionType, status]) // group balance calculations, payout checks
  @@index([stokvelGroupId, recordDate(sort: Desc)])  // recent transactions per group
}

enum TransactionType {
  CONTRIBUTION
  PAYOUT
  EXPENSE
  ADJUSTMENT
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MEMBER
}

enum PayoutModel {
  ROTATING      // Round-robin: one member gets the full pool each cycle
  END_OF_TERM   // Savings: all members get back contributions at end of term
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  EFT
  OZOW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

model ChatMessage {
  id             String       @id @default(cuid())
  stokvelGroupId String
  senderId       String
  message        String
  messageType    MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)
  pinned         Boolean      @default(false)
  group          StokvelGroup @relation(fields: [stokvelGroupId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replies        ChatReply[]

  @@map("chat_messages")
  @@index([stokvelGroupId, createdAt])
  @@index([senderId])
}

model ChatReply {
  id        String      @id @default(cuid())
  content   String
  messageId String
  senderId  String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_replies")
  @@index([messageId])
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  content   String
  groupId   String
  createdBy String
  pinned    Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  expiresAt DateTime?
  group     StokvelGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User               @relation("AnnouncementAuthor", fields: [createdBy], references: [id])
  readBy    AnnouncementRead[]

  @@map("announcements")
  @@index([groupId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Meeting {
  id          String              @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  groupId     String
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  group       StokvelGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User                @relation("MeetingAuthor", fields: [createdBy], references: [id])
  attendance  MeetingAttendance[]

  @@map("meetings")
  @@index([groupId, date])
}

model MeetingAttendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus @default(MAYBE)
  updatedAt DateTime         @updatedAt
  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_attendance")
}

enum AttendanceStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum MessageType {
  TEXT
  ANNOUNCEMENT
  SYSTEM
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  userRole   String?
  ip         String?
  method     String
  path       String
  params     Json?
  body       Json?
  result     String?  // SUCCESS or FAILED
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])  // newest-first pagination
  @@index([action])
  @@index([userId])
  @@index([action, result])          // filtered audit queries
  @@map("audit_logs")
}
