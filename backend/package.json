{
    "name": "estokvel-backend",
    "version": "1.0.0",
    "description": "Backend API for eStokvel digital stokvel management platform",
    "main": "dist/index.js",
    "scripts": {
        "start": "ts-node server.ts",
        "lint": "eslint src/**/*.ts",
        "docker:down": "docker-compose down",
        "dev:watch": "nodemon --watch src --ext ts --exec ts-node --transpile-only server.ts",
        "prisma:seed": "npx ts-node prisma/seed.ts",
        "prod": "node dist/index.js",
        "format": "prettier --write src/**/*.ts",
        "prisma:studio": "npx prisma studio",
        "prisma:generate": "npx prisma generate",
        "build": "tsc",
        "prisma:reset": "npx prisma db push --force-reset && npx ts-node prisma/seed.ts",
        "prisma:migrate": "npx prisma migrate dev",
        "dev": "nodemon --exec ts-node --transpile-only server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:auth": "ts-node --transpile-only src/__tests__/auth.test.ts",
        "docker:up": "docker-compose up -d"
    },
    "keywords": [
        "stokvel",
        "savings",
        "fintech",
        "south-africa"
    ],
    "author": "eStokvel Team",
    "license": "MIT",
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "uuid": "^13.0.0",
        "validator": "^13.15.26",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-validator": "^2.20.33",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.9",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "axios": "^1.13.6",
        "jest": "^29.5.0",
        "nodemon": "^3.1.11",
        "prisma": "^6.19.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    },
    "type": "commonjs"
}
