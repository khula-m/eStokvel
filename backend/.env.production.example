# ============================================================================
# eStokvel Production Environment Variables
# Copy this file to .env and fill in ALL values before deploying
# ============================================================================

# ─── Core ───
NODE_ENV=production
PORT=5000

# ─── Database (PostgreSQL) ───
# For managed DB: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://estokvel_user:CHANGE_ME@postgres:5432/estokvel_prod?connection_limit=20&pool_timeout=30
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=10

# Docker Compose DB credentials (only needed if using docker-compose)
POSTGRES_DB=estokvel_prod
POSTGRES_USER=estokvel_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───
# For managed Redis (Upstash/ElastiCache): redis://:password@host:port
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Authentication ───
# CRITICAL: Generate a strong random secret (min 64 chars)
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE
JWT_EXPIRES_IN=24h

# ─── CORS / Allowed Origins ───
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://admin.estokvel.co.za,https://app.estokvel.co.za

# ─── Clustering ───
# Number of worker processes (0 = auto based on CPUs, max 4)
WEB_CONCURRENCY=0

# ─── Ozow Payment Gateway ───
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=false
APP_BASE_URL=https://api.estokvel.co.za

# ─── Africa's Talking SMS ───
AT_API_KEY=
AT_USERNAME=
SMS_SENDER_ID=eStokvel
SMS_ENABLED=true

# ─── USSD Service (if deployed separately) ───
# BACKEND_API_URL=https://api.estokvel.co.za
# SERVICE_CODE=*134*911#

# ─── Admin Dashboard (build-time only) ───
# VITE_API_URL=https://api.estokvel.co.za

# ─── Mobile App (Expo build-time only) ───
# EXPO_PUBLIC_API_URL=https://api.estokvel.co.za
