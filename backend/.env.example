# =============================================================================
# eStokvel Backend — Environment Variables
# =============================================================================
# LOCAL DEV: copy this file to .env and fill in values.
#            .env is gitignored and must NEVER be committed.
#
# PRODUCTION (Railway): set every variable below in the Railway dashboard:
#   Project → Service → Variables → "+ New Variable"
#   https://railway.app/project/<your-project>/service/<backend>/variables
#
# Generate a secure JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # Set to "production" on Railway

# ── Database ──────────────────────────────────────────────────────────────────
# Railway auto-injects ${{Postgres.DATABASE_URL}} — reference it in Railway vars
# Special chars in password must be URL-encoded: # → %23  % → %25  @ → %40
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/estokvel_dev"

# ── JWT (REQUIRED — server refuses to start without this) ─────────────────────
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
JWT_EXPIRES_IN="24h"           # Use "2h" for superadmin on Railway

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway: reference ${{Redis.REDIS_URL}} in Railway vars
# Auth rate limiting + JWT revocation require Redis — do NOT run without it
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS="https://admin-dashboard-service-production-524e.up.railway.app"

# ── Ozow Payment Gateway ──────────────────────────────────────────────────────
# Get production credentials from the Ozow merchant portal
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""
OZOW_IS_TEST=true              # Set to "false" for live payments
APP_BASE_URL="https://estokvel-production.up.railway.app"

# ── Africa's Talking (SMS / USSD) ─────────────────────────────────────────────
AT_API_KEY=""
AT_USERNAME="sandbox"          # Change to your AT username in production
AT_SENDER_ID="eStokvel"
SMS_ENABLED=false

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME="eStokvel"
DEFAULT_CURRENCY="ZAR"
LOG_LEVEL="info"               # "debug" for local dev

# ── Docker Compose (local dev only — not used on Railway) ────────────────────
POSTGRES_DB=estokvel_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD="CHANGE_THIS_LOCAL_PASSWORD"
POSTGRES_PORT=5432
REDIS_PORT=6379
