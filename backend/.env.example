# ============================================
# eStokvel Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Encode special characters in password: # = %23, % = %25, @ = %40
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/estokvel_dev"

# JWT Configuration
# IMPORTANT: Generate a strong secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Redis (for caching, rate limiting, and sessions)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# SMS/USSD Provider (Africa's Talking)
# Get credentials at: https://africastalking.com/
AT_API_KEY="your_africas_talking_api_key"
AT_USERNAME="sandbox"
AT_SENDER_ID="eStokvel"
SMS_ENABLED=false

# CORS Configuration (production)
# Comma-separated list of allowed origins
# Example: https://app.estokvel.com,https://admin.estokvel.com
ALLOWED_ORIGINS=""

# Ozow Payment Gateway
# Get credentials at: https://ozow.com/
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""
OZOW_IS_TEST=true

# App Settings
APP_NAME="eStokvel"
APP_BASE_URL="http://localhost:5000"
DEFAULT_CURRENCY="ZAR"

# Docker Compose (used by docker-compose.yml)
POSTGRES_DB=estokvel_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD="CHANGE_THIS_PASSWORD"
POSTGRES_PORT=5432
REDIS_PORT=6379

# Logging
LOG_LEVEL="info"
