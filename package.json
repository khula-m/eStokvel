{
  "name": "estokvel",
  "version": "1.0.0",
  "description": "eStokvel - Digital Stokvel Management Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/mobile/eStokvelMobile"
  ],
  "scripts": {
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:build": "cd backend && npm run build",
    "mobile:start": "cd frontend/mobile/eStokvelMobile && npx expo start",
    "mobile:android": "cd frontend/mobile/eStokvelMobile && npx expo start --android",
    "mobile:ios": "cd frontend/mobile/eStokvelMobile && npx expo start --ios",
    "docker:up": "cd backend && docker-compose up -d",
    "docker:down": "cd backend && docker-compose down",
    "prisma:studio": "cd backend && npx prisma studio",
    "prisma:migrate": "cd backend && npx prisma migrate dev",
    "prisma:seed": "cd backend && npm run prisma:seed"
  },
  "keywords": [
    "stokvel",
    "savings",
    "fintech",
    "south-africa",
    "react-native",
    "nodejs"
  ],
  "author": "eStokvel Team",
  "license": "MIT"
}
