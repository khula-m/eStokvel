{
    "name":  "estokvel-backend",
    "version":  "1.0.0",
    "description":  "Backend API for eStokvel digital stokvel management platform",
    "main":  "dist/index.js",
    "scripts":  {
                    "start":  "ts-node server.ts",
                    "lint":  "eslint src/**/*.ts",
                    "docker:down":  "docker-compose down",
                    "dev:watch":  "nodemon --watch src --ext ts --exec ts-node --transpile-only server.ts",
                    "prisma:seed":  "npx ts-node prisma/seed.ts",
                    "prod":  "node dist/index.js",
                    "format":  "prettier --write src/**/*.ts",
                    "prisma:studio":  "npx prisma studio",
                    "prisma:generate":  "npx prisma generate",
                    "build":  "tsc",
                    "prisma:reset":  "npx prisma db push --force-reset \u0026\u0026 npx ts-node prisma/seed.ts",
                    "prisma:migrate":  "npx prisma migrate dev",
                    "dev":  "nodemon --exec ts-node --transpile-only server.ts",
                    "test:auth":  "ts-node --transpile-only src/__tests__/auth.test.ts",
                    "docker:up":  "docker-compose up -d"
                },
    "keywords":  [
                     "stokvel",
                     "savings",
                     "fintech",
                     "south-africa"
                 ],
    "author":  "eStokvel Team",
    "license":  "MIT",
    "dependencies":  {
                         "@prisma/client":  "^6.2.0",
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^17.2.3",
                         "express":  "^5.2.1",
                         "express-validator":  "^7.3.1",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.3",
                         "validator":  "^13.15.26",
                         "winston":  "^3.19.0"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/express-validator":  "^2.20.33",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^25.0.9",
                            "nodemon":  "^3.1.11",
                            "prisma":  "^6.2.0",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.9.3"
                        }
}
